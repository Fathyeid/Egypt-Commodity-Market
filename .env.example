# --- Required ---------------------------------------------------------
# Any PostgreSQL 14+ database (local, Neon, Railway, your own server…)
DATABASE_URL=postgres://lisan:lisan@localhost:5432/lisan
# 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000

# --- Optional: Google sign-in (button shows "not configured" until set) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: transactional email via Resend (password reset) ---------
# Without it, the reset page says email is not configured (in development the
# reset link is printed to the server console instead).
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional: AI tutor & role-play (Phase 3) ------------------------------
# Billed per use by Anthropic. The tutor shows "not configured" until this is set.
ANTHROPIC_API_KEY=
# Model and effort (defaults: claude-opus-5-5, low). Lower effort = cheaper, faster chat.
AI_MODEL=
AI_EFFORT=
# Cost guards: messages per learner per day (default 40) and a global monthly
# budget in USD (default 20). When the budget is used up, AI features pause.
AI_DAILY_MESSAGES_PER_USER=
AI_MONTHLY_BUDGET_USD=

# --- Optional: pronunciation assessment (Phase 4) ---------------------------
# Azure AI Speech resource key + region (e.g. westeurope). Billed per audio minute by Microsoft.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Comma-separated emails of admins (curriculum review at /ar/admin). Empty = no admin.
ADMIN_EMAILS=

# Factory lessons are published on import by default. Set to "draft" to review them in /admin first.
# FACTORY_STATUS=draft
